# Шаблон переменных окружения. Значения не коммитить.
# Скопируйте в .env и заполните.

# ── T-Invest API ────────────────────────────────────────────────
TINKOFF_API_TOKEN=
# sdk (единственная реализованная реализация)
BROKER_TYPE=sdk

# ── Режим торговли ──────────────────────────────────────────────
# dry_run (по умолчанию) — сигналы логируются, ордера НЕ отправляются
# live — реальные ордера; требует LIVE_CONFIRM=yes
TRADING_MODE=dry_run
LIVE_CONFIRM=
# true — генерировать фиктивные сигналы вместо рыночных
TEST_MODE=false

# ── PostgreSQL (рыночные данные, опционально live_trades) ───────
PG_HOST=
PG_USER=
PG_PASSWORD=
PG_DBNAME=

# ── Счета (AccountSelector) ─────────────────────────────────────
ACCOUNT_ID_DUAL_MA_LONG=
ACCOUNT_ID_DUAL_MA_SHORT=

# ── Шифрование account_id (Fernet key) ──────────────────────────
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Формат: 44 символа base64url (A-Z a-z 0-9 - _), заканчивается на '='.
# Ключ менять нельзя: ранее зашифрованные account_id станут нечитаемыми.
ACCOUNT_ENCRYPTION_KEY=

# ── Уведомления VK (scheduler_notifier.py) ──────────────────────
VK_TOKEN=
VK_CHAT_ID=
